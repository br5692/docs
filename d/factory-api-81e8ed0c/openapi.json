{
  "openapi": "3.1.0",
  "info": {
    "title": "Factory Partner Portal tool layer",
    "version": "1.0.0",
    "description": "One service with two doors. This document covers the web door. Agents use the MCP door at POST /mcp, which publishes the same actions with the same schemas, generated from the same list, and is discoverable at runtime through tools/list. This document is generated from the service's own definitions, so it cannot disagree with the code."
  },
  "servers": [
    {
      "url": "https://factory-partner-portal-tool-layer.onrender.com",
      "description": "Hosted sandbox service"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fp_session",
        "description": "A signed session for a partner, set by /auth/verify."
      },
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A key identifying staff, an account executive or an agent."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness, the running commit, and whether Salesforce answers.",
        "parameters": [
          {
            "name": "deep",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Any value also checks Salesforce."
          }
        ],
        "responses": {
          "200": {
            "description": "ok true, the commit, and the Salesforce state."
          }
        }
      }
    },
    "/meta/partner-types": {
      "get": {
        "summary": "Factory's own Partner Type picklist, read live from the org.",
        "responses": {
          "200": {
            "description": "The picklist values."
          }
        }
      }
    },
    "/auth/request": {
      "post": {
        "summary": "Asks for a sign-in link. Always answers the same way, whatever the address.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "website": {
                    "type": "string",
                    "description": "Honeypot. Any value writes nothing."
                  }
                },
                "required": [
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The neutral message. Reveals nothing about the address."
          },
          "429": {
            "description": "Rate limited. Retry-After in seconds."
          }
        }
      }
    },
    "/auth/verify": {
      "get": {
        "summary": "Exchanges a one-time link for a session. Single use, fifteen minutes.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session cookie set."
          },
          "401": {
            "description": "Unknown, used or expired link."
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Who the current session belongs to.",
        "responses": {
          "200": {
            "description": "The caller."
          },
          "401": {
            "description": "No session."
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "summary": "Clears the session cookie.",
        "responses": {
          "200": {
            "description": "Cleared."
          }
        }
      }
    },
    "/contracts/webhook/{provider}": {
      "post": {
        "summary": "Signing-provider callback. No provider is configured yet, so a named route is refused.",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted."
          },
          "401": {
            "description": "Signature rejected."
          },
          "404": {
            "description": "No such provider configured."
          }
        }
      }
    },
    "/actions/whoami": {
      "post": {
        "summary": "Returns the authenticated caller identity.",
        "description": "Callers permitted: partner, staff, staff-ae, agent. Callable from portal week 1. An earlier week is refused with a recorded denial. Every call writes exactly one audit row, including a refusal.",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The action result."
          },
          "403": {
            "description": "The permission table or the week gate refused the call. One audit row, outcome Denied."
          },
          "404": {
            "description": "Unknown action."
          },
          "429": {
            "description": "Rate limited."
          }
